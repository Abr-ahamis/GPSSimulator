<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.GPSSimulator" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/electric_violet</item>
        <item name="colorPrimaryVariant">@color/electric_violet</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/signal_green</item>
        <item name="colorSecondaryVariant">@color/signal_green</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/obsidian</item>
        <item name="colorSurface">@color/panel_surface</item>
        <item name="colorOnSurface">@color/soft_text</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/obsidian</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
